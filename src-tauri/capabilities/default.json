{
  "identifier": "default",
  "description": "TVBox Studio default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:scope-home-recursive",
    "http:default",
    "http:allow-fetch",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open"
  ]
}
